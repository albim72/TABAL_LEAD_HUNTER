# Publiczny adres, bez ukośnika na końcu. Dla testu lokalnego:
TABAL_ORIGIN=http://127.0.0.1:8765
# Produkcja: https://leady.twoja-domena.pl
# Dokładne hosty SMTP zatwierdzone przez administratora, rozdzielone przecinkami.
# 3.5: bez wpisu panel dopuszcza też hosty w domenie nadawcy (np. mail.tabal.pl), znanych dostawców poczty
# (home.pl, nazwa.pl, cyber_Folks, OVH, Microsoft 365, Google…) i hosty znalezione przyciskiem „Wykryj ustawienia”.
TABAL_SMTP_HOSTS=
# 1 = dowolny host SMTP wpisany w panelu (tylko gdy dostęp do panelu jest chroniony VPN / reverse proxy).
TABAL_SMTP_ALLOW_ANY=0
# Ustaw 1 tylko za nginx nadpisującym X-Real-IP i z portem aplikacji niedostępnym z sieci.
TABAL_TRUST_PROXY=0
# --- Wysyłka z bok@tabal.pl (3.2) ---
# Host SMTP skrzynki bok@tabal.pl (od administratora poczty TABAL), np. host z panelu hostingu.
TABAL_SMTP_HOST=
TABAL_SMTP_PORT=465
# ssl (port 465) albo starttls (port 587)
TABAL_SMTP_SECURITY=ssl
TABAL_SMTP_USER=bok@tabal.pl
TABAL_SMTP_SENDER=bok@tabal.pl
TABAL_SMTP_SENDER_NAME=TABAL — Biuro Obsługi Klienta
TABAL_SMTP_INTERVAL=30
# Opcjonalnie: hasło skrzynki. Jeśli puste, wpisz je w zakładce Wysyłka (trzymane tylko w pamięci serwera).
# Plik .env chroń uprawnieniami (chmod 600) i nie wysyłaj go e-mailem.
TABAL_SMTP_PASSWORD=

# --- 3.11: TRYB API — wyszukiwanie na serwerze, na tokenach TABAL (bez 5-godzinnego limitu ChatGPT) ---
# Klucz z konta API dostawcy (np. platform.openai.com → API keys). To NIE jest subskrypcja ChatGPT Plus/Pro/Business:
# konto API doładowuje się osobno (tokeny). Klucz nie trafia do przeglądarki ani do kopii danych.
TABAL_AI_API_KEY=
# Model z wyszukiwaniem w sieci, dokładnie tak jak w panelu dostawcy (np. ten sam, który dobrze działał w Work).
TABAL_AI_MODEL=
# Adres API zgodnego z OpenAI Responses API (domyślnie OpenAI).
TABAL_AI_BASE_URL=https://api.openai.com/v1
# Nazwa narzędzia wyszukiwania u dostawcy (OpenAI: web_search).
TABAL_AI_SEARCH_TOOL=web_search
# Głębokość rozumowania: low / medium / high (medium = jak „średnie” w Work).
TABAL_AI_REASONING=medium
# Ile zadań naraz (1–12). Więcej = szybciej, ale wyższe chwilowe zużycie limitów konta API.
TABAL_AI_PARALLEL=4
# Po ilu minutach przerwać zadanie, które nie kończy się (5–600).
TABAL_AI_MAX_MINUTES=90
# Opcjonalnie: cena za 1 mln tokenów (wejście / wyjście) z cennika dostawcy — panel pokaże koszt każdego zadania.
TABAL_AI_PRICE_IN=0
TABAL_AI_PRICE_OUT=0
TABAL_AI_CURRENCY=USD
